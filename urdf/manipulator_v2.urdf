<?xml version="1.0"?>
<robot name="origins">
  <link name="base_link">
    <visual>
     <origin xyz="0 0 0" rpy="1.5708 0.0 0.0"/>
      <geometry>
            <mesh filename="stl/umirobot_l1_meshlab.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 -3.14159 0"/>
      <geometry>
        <box size="0.065 0.055 0.045"/>
      </geometry>
    </collision>
  </link>

  <link name="l1_cover">
    <visual>
      <origin xyz="0 -0.002 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="stl/umirobot_l1_cover.stl" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00005"/>
      <origin xyz="0 -0.002 0" rpy="0 0 0"/>
    </inertial>
    <collision>
      <origin xyz="0 -0.002 0" rpy="0 -3.14159 0"/>
      <geometry>
        <box size="0.065 0.055 0.010"/>
      </geometry>
    </collision>
  </link>

  <link name="l2">
    <visual>
     <origin xyz="0 0 0.555" rpy="4.71239 0 0"/>
      <geometry>
            <mesh filename="stl/umirobot_l2_shifted.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0004" iyy="0.0004" izz="0.0004"/>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.555" rpy="0 -3.14159 0"/>
      <geometry>
        <box size="0.065 0.035 0.055"/>
      </geometry>
    </collision>
  </link>

  <link name="l2_cover">
    <visual>
     <origin xyz="0 0 0.555" rpy="4.71239 0 0"/>
      <geometry>
            <mesh filename="stl/umirobot_l2_cover.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" iyy="0.00005" izz="0.00005"/>
      <origin xyz="0 0 0.555" rpy="0 0 0"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.555" rpy="0 -3.14159 0"/>
      <geometry>
        <box size="0.065 0.0095 0.055"/>
      </geometry>
    </collision>
  </link>

  <link name="l3">
    <visual>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <!-- <origin xyz="0 0 -0.45" rpy="0 0 0"/> -->
      <geometry>
            <mesh filename="stl/umirobot_l3.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="0.0009" iyy="0.0002" izz="0.0009"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- <origin xyz="0 0 -0.45" rpy="0 0 0"/> -->
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 -3.14159 0"/>
      <!-- <origin xyz="0 0 -0.45" rpy="0 -3.14159 0"/> -->
      <geometry>
        <box size="0.040 0.010 0.120"/>
      </geometry>
    </collision>
  </link>

  <link name="l4">
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
      <!-- <origin xyz="0.45 0 0" rpy="0.0 0.0 0.0"/> -->
      <geometry>
         <mesh filename="stl/umirobot_l4.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0010" iyy="0.00025" izz="0.0010"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- <origin xyz="0.45 0 0" rpy="0 0 0"/> -->
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 -3.14159 0"/>
      <!-- <origin xyz="0.45 0 0" rpy="0 -3.14159 0"/> -->
      <geometry>
        <box size="0.120 0.025 0.040"/>
      </geometry>
    </collision>
  </link>
 
  <link name="l5">
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
      <!-- <origin xyz="0 -0.17 0.01" rpy="0.0 0.0 0.0"/> -->
      <geometry>
         <mesh filename="stl/umirobot_l5.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00015" iyy="0.00015" izz="0.00015"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- <origin xyz="0 -0.17 0.01" rpy="0 0 0"/> -->
    </inertial>
    <collision>
      <origin xyz="0 0 0" rpy="0 -3.14159 0"/>
      <!-- <origin xyz="0 -0.17 0.01" rpy="0 -3.14159 0"/> -->
      <geometry>
        <box size="0.060 0.040 0.032"/>
      </geometry>
    </collision>
  </link>
 

  

  <joint name="l1_to_l1_cover" type="fixed">
    <parent link="base_link"/>
    <child link="l1_cover"/>
    <origin xyz="0 0 0"/>
  </joint>

  <joint name="joint_l1_l2" type="revolute">
    <parent link="base_link"/>
    <child link="l2"/>
    <origin xyz="0 0 0.525" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit upper="3.14159" lower="-3.14159" effort="10.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <joint name="joint_l2_l2_cover" type="fixed">
    <parent link="l2"/>
    <child link="l2_cover"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="joint_l2_l3" type="revolute">
    <parent link="l2"/>
    <child link="l3"/>
    <origin xyz="-0.1 0.3 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.1781" upper="1.1781" effort="10.0" velocity="1.0"/>
    <!-- same range, shifted 
    <limit lower="-1.1781" upper="1.1781"/>
    Then compensate in:
      controller
      initial joint state -->
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

    <joint name="joint_l3_l4" type="revolute">
      <!-- <origin xyz="0 -0.4 -0.8" rpy="3.14159 0 3.14159"/> -->
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="l3"/>
      <child link="l4"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit upper="0.7854" lower="-3.14" effort="10.0" velocity="1.0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>
    
    <joint name="joint_l4_l5" type="revolute">
      <!-- <origin xyz="1.5 0.115 -0.01" rpy="3.14159 0 3.14159"/> -->
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <parent link="l4"/>
      <child link="l5"/>
      <axis xyz="1 0 0"/>
      <limit upper="3.14159" lower="-3.14159" effort="10.0" velocity="1.0"/>
      <dynamics damping="0.1" friction="0.01"/>
    </joint>


</robot>